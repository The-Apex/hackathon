# BloodSync Environment Configuration
# Database Connection (MySQL / MariaDB via XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=blood_bank
DB_PORT=3306

# Google Cloud Maps API Key
# Required APIs in Google Cloud Console:
# 1. Maps JavaScript API
# 2. Places API (for Autocomplete location search)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# SMS Gateway (Optional: Fast2SMS or Twilio)
FAST2SMS_API_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Live Email Delivery (Authenticated SMTP)
# To send real emails to live inboxes (Gmail, Outlook, Brevo, SendGrid), set your credentials here:
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-16-character-app-password
# SMTP_SECURE=tls
# SMTP_FROM=your-email@gmail.com
# SMTP_FROM_NAME="BloodSync Emergency Network"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM=no-reply@bloodsync.com
SMTP_FROM_NAME="BloodSync Emergency Network"
